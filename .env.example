# LeadLens configuration.
#
# Copy to `.env` and fill in for a deployment. Leave everything unset for local development:
# with no Cloudflare values the auth layer is inert, and the app behaves exactly as before.
#
# Do not commit the filled-in `.env`.

# Pick ONE topology:
#   Cloudflare Access  -> set CF_ACCESS_* below.            deploy/RUNBOOK.md
#   Tailscale Serve    -> set LEADLENS_TAILSCALE_AUTH=1.    deploy/RUNBOOK-TAILSCALE.md
#   HTTP Basic Auth    -> set BASIC_AUTH_USER/PASS below.   deploy/RUNBOOK-RAILWAY.md
# Precedence when more than one is configured: Cloudflare (a verified signature) beats
# Tailscale (a proxy header) beats Basic Auth (a shared password).

# ---- Cloudflare Access (leave blank locally) --------------------------------------------
# Both must be set for enforcement to switch on. If either is blank, every endpoint is open
# and the app logs a warning at startup.

# Your Cloudflare Zero Trust team domain, without the scheme.
#   Zero Trust dashboard -> Settings -> Custom Pages -> Team domain
CF_ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag of the Access application protecting this app.
#   Zero Trust -> Access -> Applications -> (your app) -> Overview -> Application Audience (AUD) Tag
CF_ACCESS_AUD=

# ---- Tailscale Serve (the no-domain, no-Cloudflare option) -------------------------------
# Set to 1 when this app sits behind `tailscale serve`. The app then takes the caller's
# identity from the Tailscale-User-Login header that Serve stamps on every request, which is
# what keeps the reader/writer split below working without Cloudflare.
#
# Only sound while the app is reachable through Serve alone: keep the 127.0.0.1 binding from
# docker-compose.tailscale.yml and publish no host port. A header is not a signature -- it is
# trustworthy here because nothing but tailscaled can reach the port, not on its own merits.
#
# Leaving this unset in a Tailscale deployment means NO gate at all: every tailnet member can
# delete leads and trigger retrains. deploy.sh refuses to deploy in that state.
LEADLENS_TAILSCALE_AUTH=

# ---- HTTP Basic Auth (the public-PaaS option: no domain, no tunnel, no tailnet) ---------
# One shared username and password, checked in constant time. Weaker than both topologies
# above -- no per-person identity, so the reader/writer split below does not apply -- but it
# is a real gate, and it is the only one available on a host like Railway or Render where the
# service is reachable straight from the internet.
#
# Both must be set. Either alone leaves the app ungated, which on a PaaS is a hard boot
# failure (see LEADLENS_REQUIRE_AUTH). Generate the password with a password manager; it is
# the only thing between the internet and the delete routes.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ---- Who gets in ------------------------------------------------------------------------
# Comma-separated. Checked after Cloudflare or Tailscale has already established who the
# caller is, so this is a second, independent gate rather than the only one. Both are IGNORED
# in Basic Auth mode, which has no per-person identity to match against.
#
# Left blank on purpose: a placeholder address here is worse than an empty value. Blank means
# "anyone the gate admits"; a placeholder means "nobody real", which reads as a broken
# deployment rather than a misconfigured one. Fill them in only with addresses that exist.

# May open the dashboard. Blank = anyone the gate admits (anyone in the Access policy, or --
# in Tailscale mode -- every member of your tailnet).
#   e.g. LEADLENS_ALLOWED_EMAILS=you@yourdomain.com,ceo@yourdomain.com
LEADLENS_ALLOWED_EMAILS=

# May upload, edit leads, delete, and retrain. Blank = same as LEADLENS_ALLOWED_EMAILS.
# Listing only yourself gives the CEO the dashboard without the ability to delete a lead
# or kick off a retrain by accident.
#   e.g. LEADLENS_WRITER_EMAILS=you@yourdomain.com
LEADLENS_WRITER_EMAILS=

# ---- Fail-closed on a public deploy -----------------------------------------------------
# When set truthy (1/true/yes/on), the app REFUSES TO START unless one of the gates above is
# configured -- turning "silently open" into a hard boot failure. Known public hosts are
# auto-detected from the markers they inject (RENDER, RAILWAY_ENVIRONMENT, FLY_APP_NAME, DYNO,
# WEBSITE_INSTANCE_ID), so those fail closed even if you forget this. Anywhere internet-facing
# that is NOT on that list still needs this set by hand. Leave unset for local development,
# where running open is intended.
LEADLENS_REQUIRE_AUTH=

# ---- Demo deployment --------------------------------------------------------------------
# Set to 1 on the disposable public demo (the one that must never hold real customer data).
# It disables the data-import endpoints, so a slip cannot load PII onto a public host. Leave
# unset on the real business deployment, which needs imports.
LEADLENS_DEMO_MODE=

# ---- Request limits (optional; sane defaults in backend/security.py) --------------------
# Overrides for the in-process rate limiter and body caps. Defaults are generous enough that a
# human never hits them; tune down if a deploy needs to be stricter.
#   LEADLENS_MAX_BODY_MB=30          largest accepted request body
#   LEADLENS_MAX_UPLOAD_MB=25        largest accepted file upload
#   LEADLENS_RATE_GENERAL=600        requests per IP per LEADLENS_RATE_GENERAL_WINDOW (60s)
#   LEADLENS_AUTH_FAIL_LIMIT=15      failed sign-ins per IP before a 900s throttle (Basic Auth)
#   LEADLENS_RATE_RETRAIN=6          retrain requests per IP per 300s

# ---- CORS -------------------------------------------------------------------------------
# In production the frontend is served from this same origin, so no CORS is needed: set this
# to empty. The default (http://localhost:5173) exists only for `pnpm dev`.
LEADLENS_CORS_ORIGINS=

# ---- Storage ----------------------------------------------------------------------------
# The Docker image already sets LEADLENS_DATA_DIR=/data, which is the mounted volume, so you
# do not need to set anything here for a container deployment.
#
# Use LEADLENS_DATA_DIR rather than LEADLENS_DB_PATH: it moves the database, uploads/ and
# previews/ together. Setting only the DB path leaves uploads and previews on the container
# filesystem, where the next redeploy discards them.
# LEADLENS_DATA_DIR=/data
#
# Railway only: the image runs as UID 10001, and Railway mounts volumes root-owned, so a
# service with a volume attached hits permission errors on /data. Railway's documented
# workaround is RAILWAY_RUN_UID=0, which runs the container as root and gives up the
# non-root property. Acceptable on the demo (no real data, no volume needed); on anything
# holding real leads, use the Tailscale deployment instead of paying that price.
# RAILWAY_RUN_UID=0

# ---- Cloudflare Tunnel (Cloudflare topology only; leave blank for Tailscale) ------------
# From: Zero Trust -> Networks -> Tunnels -> (your tunnel) -> Install connector. Copy the
# token out of the shown command. This is a credential: it belongs in .env, never in git.
CF_TUNNEL_TOKEN=
